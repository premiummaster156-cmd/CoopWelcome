{
  "name": "coopwelcome",
  "version": "2.0.0",
  "description": "CoopWelcome — a modern slash-command Discord welcome and verification bot.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
